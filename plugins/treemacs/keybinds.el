;;; -*- lexical-binding: t; -*-
(global-set-key (kbd "<leader>s") 'treemacs)

(with-eval-after-load 'treemacs-evil
  (mapc (lambda (binding) (evil-define-key 'treemacs treemacs-mode-map (kbd (car binding)) (cdr binding)))
        '(("DEL" . treemacs-root-up)
          ("." . treemacs-root-down)
          ("a" . treemacs-create-file)
          ("A" . treemacs-create-dir)
          ("d" . treemacs-delete-file)
          ("r" . treemacs-rename-file)
          ("c" . treemacs-copy-file)
          ("m" . treemacs-move-file)
          ("o" . treemacs-visit-node-in-external-application)
          ("P" . treemacs-peek-mode)
          ("y" . treemacs-copy-absolute-path-at-point)
          ("u" . treemacs-refresh)
          ("H" . treemacs-toggle-show-dotfiles)
          ("I" . treemacs-hide-gitignored-files-mode)
          ("Z" . treemacs-collapse-all-projects)
          ("TAB" . treemacs-mark-or-unmark-path-at-point)
          ("C-s" . treemacs-visit-node-horizontal-split)
          ("C-v" . treemacs-visit-node-vertical-split)
          ("S-<return>" . treemacs-visit-node-ace))))
